### Node and Dependency Files ###
# Node modules – install dependencies locally, but do not include in the repository.
node_modules/

# Package-lock (or yarn.lock, pnpm-lock.yaml) files – lock files can sometimes be included
# in your repository to ensure consistent installs across machines. However, many teams
# prefer to exclude them. Adjust according to your team's workflow.
package-lock.json
yarn.lock
pnpm-lock.yaml

### Build and Output Directories ###
# Vite build output directory (adjust if you changed the default build folder)
dist/

# Temporary build or output directories (for example, if you use a “build” folder)
build/

# Cache directories generated by bundlers, test runners, etc.
.vite/
.cache/
.eslintcache

### Log Files ###
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

### Editor and OS Files ###
# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDEs and editors (VSCode, Sublime, etc.)
.vscode/
.DS_Store
.idea/
*.sublime-workspace
*.sublime-project

### Test and Misc Files ###
# Test coverage output (for example, if you're using Jest)
coverage/

# Temporary files created by your OS or tools
tmp/
temp/
*.tmp
*.temp

# Environment variables (if you’re not committing them)
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build artifacts for TypeScript if you’re emitting files (when using noEmit, you might not need these)
*.tsbuildinfo

# Mock files for testing (if you decide to stub assets with mocks)
__mocks__/

### Specific to Vite and Modern Frontends ###
# Vite stores dependency caches in "node_modules/.vite"
node_modules/.vite/

# If you use a public folder for static assets that aren’t processed by Vite, decide if it should be tracked.
# Generally, you want to track the source for them (e.g., public/) but ignore generated versions.
cypress/screenshots/
cypress/videos/